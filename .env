# ▃▃▃▃▃▃▃▃▃▃▃▃ Bakini Noir — development shop ▃▃▃▃▃▃▃▃▃▃▃▃
# These VITE_* values are public client configuration and are only read in
# development. In production Selldone injects the real shop, defaults and
# theme of whichever shop runs this Layout.

# Bakio (shop 15740), the pastry shop this Layout was drawn for. Its public
# xapi name is "bakio" (https://bakio.myselldone.com).
VITE_APP_SAMPLE_SHOP_NAME=bakio

# The designed home is the shop page. Values: blog | avocado | hyper |
# community | shop | map | <page id>
VITE_APP_SAMPLE_SHOP_CUSTOM_HOME=shop

VITE_APP_SAMPLE_DEFAULT_CURRENCY=USD
VITE_APP_SAMPLE_DEFAULT_COUNTRY=US
VITE_APP_SAMPLE_DEFAULT_LANGUAGE=en

# Noir: deep caramel actions on a dark stage, gold for small type.
VITE_APP_SAMPLE_THEME_COLOR_LIGHT="#A0522D"
VITE_APP_SAMPLE_THEME_COLOR_DARK="#893E17"
VITE_APP_SAMPLE_THEME_COLOR_DEEP_DARK="#120C10"
VITE_APP_SAMPLE_THEME_COLOR_INFO="#8A5E2E"

# ▃▃▃▃▃▃▃▃▃▃▃▃ Dev Server ▃▃▃▃▃▃▃▃▃▃▃▃

VITE_APP_DEV_SERVER_HOST=localhost
VITE_APP_DEV_SERVER_PORT=9135
VITE_APP_DEV_SERVER_HTTPS=FALSE
# The account design: A, "desk" (side rail and order cards). Releases set it
# themselves (release.sh <version> desk).
VITE_KALIO_ACCOUNT=desk
